{
  "name": "flexocolor-lab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json *.yaml .github/workflows/*.yml docs/*.md README.md",
    "demo:export": "node scripts/demo.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "dexie": "^4.2.1",
    "decimal.js": "^10.6.0",
    "zod": "^4.1.12",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "fake-indexeddb": "^6.2.4",
    "@playwright/test": "^1.56.1",
    "vite-plugin-pwa": "^1.1.0",
    "sharp": "^0.34.5",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@11.25.0"
}
